# ─── ORCH — Variáveis de ambiente ────────────────────────────────────────────
# Copie para .env e preencha com suas chaves reais:
#   cp .env.example .env

# ── Obrigatórias ─────────────────────────────────────────────────────────────

# Claude (Anthropic) — usado em orch_core (critic + scorer) e pain_radar_adapter
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT) — usado em orch_core (proposer + refiner) e competitor_research_adapter
OPENAI_API_KEY=sk-...

# ── Recomendadas ──────────────────────────────────────────────────────────────

# Perplexity — busca de concorrentes na web (competitor_collector)
# Se ausente, competitor_collector usa GPT como fallback
PERPLEXITY_API_KEY=pplx-...

# ── Opcionais ────────────────────────────────────────────────────────────────

# Telegram — necessário apenas para telegram_command_router.py
TELEGRAM_BOT_TOKEN=123456789:ABC-...
TELEGRAM_CHAT_ID=987654321

# Configurações dos modelos (padrões já definidos no código)
GPT_MODEL=gpt-4o
PERPLEXITY_MODEL=sonar

# Proteção do painel MYO (deixe vazio para desabilitar auth)
MYO_PASSWORD=

# Stripe (opcional — painel MYO /api/stripe-revenue)
STRIPE_SECRET_KEY=sk_live_...
