#!/usr/bin/env bash
# direnv — MYO OS
# Requer: eval "$(direnv hook zsh)" no ~/.zshrc
# Autoriza: direnv allow (1ª vez)

dotenv_if_exists .env

# Python 3.14 via venv (migração pra uv pendente)
if [ -d "venv" ]; then
  source venv/bin/activate
elif [ -d ".venv" ]; then
  source .venv/bin/activate
fi

export PYTHONPATH="$PWD:${PYTHONPATH:-}"
